// The local receiver is deliberately unauthenticated. This edge's exporter is
// deliberately authenticated with a certificate that central-alloy must reject.
otelcol.receiver.otlp "unauthorized_edge" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    metrics = [otelcol.processor.batch.unauthorized_edge.input]
    logs    = [otelcol.processor.batch.unauthorized_edge.input]
    traces  = [otelcol.processor.batch.unauthorized_edge.input]
  }
}

otelcol.processor.batch "unauthorized_edge" {
  output {
    metrics = [otelcol.exporter.otlp.central.input]
    logs    = [otelcol.exporter.otlp.central.input]
    traces  = [otelcol.exporter.otlp.central.input]
  }
}

otelcol.exporter.otlp "central" {
  client {
    endpoint = "central-alloy:4317"

    tls {
      // Verify the genuine central server, but present a rogue client identity.
      ca_file     = "/certs/ca.crt"
      cert_file   = "/certs/untrusted-edge-client.crt"
      key_file    = "/certs/untrusted-edge-client.key"
      server_name = "central-alloy"
    }
  }
}
