# Copy to .env and fill in with values from your Grafana Cloud stack's
# "Send Metrics" and "Send Logs" pages, then `set -a; source .env; set +a`.
GRAFANA_CLOUD_CLUSTER_NAME=prom-exporter-demo

GRAFANA_CLOUD_PROMETHEUS_URL=https://PROMETHEUS_URL/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
GRAFANA_CLOUD_PROMETHEUS_TOKEN=

GRAFANA_CLOUD_OTLP_ENDPOINT=https://OTLP_ENDPOINT_URL/otlp
GRAFANA_CLOUD_OTLP_USERNAME=
GRAFANA_CLOUD_ACCESS_POLICY_TOKEN=
