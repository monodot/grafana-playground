# Copy to .env and fill in with values from your Grafana Cloud stack's
# "Send Metrics" and "Send Logs" pages, then `set -a; source .env; set +a`.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-XX-XXXXX-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS="Authorization=Basic xxxxxxxxxxxxxxxxxxxxxxx="
