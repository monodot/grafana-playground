{
  "title": "Orders service overview",
  "uid": "orders-overview",
  "tags": ["orders-demo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate by service",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (job) (rate(http_server_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP p95 latency by service (click an exemplar dot to open the trace)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{job}} p95",
          "exemplar": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Database calls (from span metrics)",
      "description": "SELECT / INSERT / UPDATE spans against Oracle, from the legacy WildFly app and the batch job. To backtrace: click an exemplar, open the trace, and read upwards to see which caller led to this database call.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, span_name) (rate(traces_spanmetrics_calls_total{span_name=~\"(INSERT|SELECT|UPDATE).*\"}[$__rate_interval]))",
          "legendFormat": "{{service}}: {{span_name}}",
          "exemplar": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Error rate by service",
      "description": "To quick-filter the actual failing traces, query Tempo with TraceQL: { status = error }",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "fillOpacity": 20 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{service}} errors",
          "exemplar": true
        }
      ]
    }
  ]
}
